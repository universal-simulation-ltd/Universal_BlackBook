{
  "name": "universal-blackbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Universal BlackBook — a private address book. Custom categories, how often you want to be in touch, and notes. No account needed: sync with your Universal ID across devices (optional, end-to-end encrypted), or a backup file.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "credits": "node ../scripts/gen-credits.mjs . --repo https://github.com/universal-simulation-ltd/Universal_BlackBook && node scripts/notices-data.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backup": "vite build && node scripts/backup-file.e2e.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:mobile": "npm run build:desktop",
    "check:mobile-bundle": "node scripts/verify-mobile-bundle.mjs",
    "check:ios-launch": "node scripts/verify-ios-launch.mjs",
    "cap:sync": "node scripts/contacts-read-only.mjs --strict && npm run build:mobile && npx cap sync && npm run check:mobile-bundle && npm run check:ios-launch",
    "cap:open:ios": "npx cap open ios",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node scripts/contacts-read-only.mjs"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@unisim/media": "^0.7.0",
    "@unisim/sdk": "^0.213.0",
    "fflate": "^0.8.3",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
