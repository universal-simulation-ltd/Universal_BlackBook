<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- ⚠️ The last three items are the fallback half of Capacitor 8's
         SystemBars handling (capacitor.config.ts). On a WebView older than
         Chromium 140 SystemBars pads the web view out from under the status
         bar and the camera cutout instead of drawing edge-to-edge, and those
         strips show the WINDOW background. DayNight takes that background and
         the status-bar icon colour from the SYSTEM theme, so without these a
         phone in dark mode would get a black strip with white icons over the
         app's light paper. Pinned to the app's default, LIGHT (BlackBook was
         dark-only until 2026-10-22); when the app is set to Dark, or Match my
         device on a phone in dark mode, WindowThemePlugin lays
         WindowStrip.Dark (below) over this at run time. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/unisimWindowBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Theme overlays WindowThemePlugin applies over AppTheme.NoActionBar when
         the app's own theme changes. Only the window background: SystemBars
         repaints the strips from it on every style change and configuration
         change, so the colour has to live in the theme, not on the view. -->
    <style name="WindowStrip.Light" parent="">
        <item name="android:windowBackground">@color/unisimWindowBackground</item>
    </style>

    <style name="WindowStrip.Dark" parent="">
        <item name="android:windowBackground">@color/unisimWindowBackgroundDark</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>