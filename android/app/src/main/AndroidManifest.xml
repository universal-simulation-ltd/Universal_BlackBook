<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- "From my contacts" and "Import my phone contacts" READ the phone's
         contacts, on the phone, and never write to them. Write access is
         stripped from the merged manifest so no dependency can ever bring it
         in. The contacts plugin is patched to ask for read only
         (scripts/contacts-read-only.mjs, run on install and by cap:sync);
         unpatched, it fails closed rather than asking for write. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove" />
    <!-- Reminders (@capacitor/local-notifications, 2026-10-25). The plugin
         asks for exact alarms too; Play keeps those for alarm and calendar
         apps, so they are removed and a reminder may arrive a few minutes
         late on Android (inexact, allowed while the phone idles). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <!-- "Fill in my current location" (Tune this app, off to start): the
         town is enough, so coarse location only, asked for when the setting
         is turned on. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
