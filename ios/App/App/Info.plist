<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Universal BlackBook</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ⚠️ REQUIRED, and not only for the bulk import. iOS terminates the app
	     on the first CNContactStore access with no usage string — and
	     @capacitor-community/contacts asks for permission before opening the
	     PICKER too (ContactsPlugin.pickContact → requestContactsPermission),
	     so "From my contacts" crashes without this line just as surely as
	     "Import my phone contacts" does. This app only ever READS. -->
	<key>NSContactsUsageDescription</key>
	<string>BlackBook can fill in a new contact from your phone's address book, so you only have to type the private note. It never changes your contacts.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- BEGIN unisim suite app links — generated by scripts/add-suite-app-links.mjs, do not hand-edit -->
	<!-- This app's own scheme. Another suite app opens it with
	     unisim-blackbook:// — see UnisimSuiteAuthPlugin.openApp. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uk.co.unisim.blackbook</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unisim-blackbook</string>
			</array>
		</dict>
	</array>
	<!-- Every suite scheme this app may ask about. ⚠️ canOpenURL answers FALSE
	     for anything not listed here and says so only in the device console —
	     which the switcher cannot tell apart from "not installed". The full
	     list is written into every app deliberately: identical blocks make a
	     stale one visible. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>unisim-cyber-assess</string>
		<string>unisim-workplace-assess</string>
		<string>unisim-fire-assess</string>
		<string>unisim-coshh-assess</string>
		<string>unisim-risk-assess</string>
		<string>unisim-pdf</string>
		<string>unisim-images</string>
		<string>unisim-qr</string>
		<string>unisim-compress</string>
		<string>unisim-converter</string>
		<string>unisim-polling</string>
		<string>unisim-blackbook</string>
		<string>unisim-ai</string>
	</array>
	<!-- END unisim suite app links -->
</dict>
</plist>
